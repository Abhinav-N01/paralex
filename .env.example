# ─────────────────────────────────────────────────────────────
# CoCounsel EB-5 — Environment Variables
# Copy this to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# Required: Anthropic API key (get one at console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults work for local dev)
ENVIRONMENT=development
DEBUG=true
CLAUDE_MODEL=claude-sonnet-4-6

# EB-5 minimum investment thresholds (USD)
EB5_TEA_MINIMUM=800000
EB5_STANDARD_MINIMUM=1050000
